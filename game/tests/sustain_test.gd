extends SceneTree

const Session = preload("res://rhythm_session.gd")

func _initialize() -> void:
	var s = Session.new()
	var hold := [{"time": 1.0, "end_time": 2.0, "kind": "hold", "lane": 0}]
	s.reset(hold)
	s.press("key_J", 0, 1.0)
	assert(s.score == 0 and s.notes[0]["active"])
	s.update(1.7)
	assert(s.score == 0)
	s.update(2.0)
	assert(s.score == 1000 and s.counts["PERFECT"] == 1)
	s.release("key_J", 2.01)
	assert(s.score == 1000)
	s.reset(hold)
	s.press("finger_1", 0, 1.0)
	s.release("finger_1", 1.5)
	assert(s.counts["MISS"] == 1 and s.combo == 0)
	s.update(4.0)
	assert(s.counts["MISS"] == 1)
	s.reset(hold)
	s.press("key_J", 0, 1.0)
	s.press("key_Left", 0, 1.3)
	s.release("key_J", 1.4)
	assert(s.lane_held(0) and s.counts["MISS"] == 0)
	s.update(2.0)
	assert(s.score == 1000)
	s.reset(hold)
	s.press("key_J", 0, 1.0)
	s.release("key_J", 1.94)
	assert(s.counts["GOOD"] == 1)
	s.reset(hold)
	s.press("touch_0", 0, 1.0)
	s.suspend()
	s.update(9.0)
	assert(s.counts["MISS"] == 0 and not s.lane_held(0))
	s.resume(1.4)
	s.press("touch_0", 0, 1.6)
	s.update(2.0)
	assert(s.score == 1000)
	s.reset(hold)
	s.press("a", 0, 1.0)
	s.suspend()
	s.resume(1.2)
	s.press("a", 0, 1.9)
	assert(s.counts["MISS"] == 1)
	var roll := [{"time": 1.0, "end_time": 2.2, "kind": "roll", "lane": 1, "required_hits": 6}]
	s.reset(roll)
	s.press("held", 1, 1.0)
	for i in range(20):
		s.press("held", 1, 1.1 + i * .02)
	assert(s.notes[0]["hits"] == 1)
	s.update(2.3)
	assert(s.counts["MISS"] == 1)
	s.reset(roll)
	for i in range(6):
		s.press("tap", 1, 1.0 + i * .2)
		s.release("tap", 1.01 + i * .2)
	s.update(2.21)
	assert(s.score == 1000 and s.counts["PERFECT"] == 1)
	s.reset(roll)
	s.press("late", 1, 1.5)
	assert(s.notes[0]["hits"] == 1)
	# A hold and independent taps on the other lane must coexist.
	s.reset(hold + [{"time": 1.4, "kind": "tap", "lane": 1}])
	s.press("hold", 0, 1.0)
	s.press("tap", 1, 1.4)
	s.release("tap", 1.42)
	s.update(2.0)
	assert(s.score == 2000 and s.combo == 2)
	var candidates: Array = [{"time": 1.0, "lane": 0, "kind": "tap", "done": false}, {"time": 1.21, "end_time": 2.0, "lane": 0, "kind": "roll", "done": false}]
	assert(preload("res://judge.gd").nearest(candidates, 0, 1.05) == 0)
	print("PASS: hold completion, early release, tail tolerance, two sources, pause recovery, roll counts, no held-key cheat, cross-lane play")
	quit()
